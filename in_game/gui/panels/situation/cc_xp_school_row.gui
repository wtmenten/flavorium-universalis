######################################################################
# Flavorium Universalis — Court Ledger: one school's row
#
# Expects the FOUNDER as its Character datacontext, which is what the country's
# cc_xp_school_N_founder variable holds. The founder may well be dead by the time this
# renders; that is the point of an institution, and the row says so.
#
# THE DISCIPLINE COMES FROM THE COUNTRY, NOT THE FOUNDER. Each caller supplies it through
# the "school_track" block, reading its own cc_xp_school_N_track. That variable is the
# authoritative record of what a school teaches: it is written once at founding and does
# not depend on the founder's character surviving. Reading the founder's own
# cc_xp_school_track would work today but ties a permanent institution to the lifetime of
# one character object.
#
# Properties are declared at top level, not wrapped in a widget: `using = <template>`
# merges a template's contents into the widget it is used on, and an extra layer here
# collapses to zero size and takes its children's mouse input with it.
# See docs/scripting-gotchas.md.
######################################################################

template cc_xp_school_row {
	layoutpolicy_horizontal = expanding
	size = { -1 46 }
	background = { using = color_whiteish_texture  alpha = 0.10 }

	hbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		margin = { 6 3 }
		spacing = 6

		portrait_standard_head_framed_button = {
			size = { 34 38 }
			onclick = "[ShowCharacter(Character.Self)]"
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 0

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 5
				text_single = {
					fontsize = 12
					default_format = "#weak"
					align = left|nobaseline
					text = "CC_XP_SCHOOL_FOUNDED_BY"
				}
				text_single = {
					fontsize = 13
					align = left|nobaseline
					text = "[Character.GetShortNameWithNoTooltip]"
				}
				expand = {}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4

				text_single = {
					fontsize = 10
					default_format = "#weak"
					align = left|nobaseline
					text = "CC_XP_SCHOOL_TEACHES"
				}

				# Filled by the caller with its own slot's country variable.
				block "school_track" {}

				# An institution outlives the person who founded it. Worth saying plainly.
				text_single = {
					fontsize = 10
					default_format = "#weak"
					align = left|nobaseline
					visible = "[Not(Character.IsAlive)]"
					text = "CC_XP_SCHOOL_FOUNDER_DEAD"
					tooltip = "CC_XP_SCHOOL_FOUNDER_DEAD_TT"
				}

				expand = {}
			}
		}
	}
}
