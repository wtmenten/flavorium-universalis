situation_panel = {

	##################################### MAIN IMAGE #####################################

	blockoverride "situation_panel_image" {}

	##################################### SUBHEADER #####################################

	blockoverride "situation_subheader_content" {}

	##################################### MAIN CONTENT #####################################

	blockoverride "situation_panel_main_content" {

		# End Requirements card
		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'ccim_requirements_toggled' )]"
			}
			blockoverride "header_text" {
				text = "END_REQUIREMENTS"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "bottom_content" {
				TooltipRequirementsList = {
					textcontext = "[SituationView.GetActiveSituation.GetSituation.GetEndConditions]"
				}
			}
			blockoverride "visible_hint" {}
			blockoverride "onaction_hint" {
				action_tooltip = {
					title = "OPEN_HINT"
					on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_cc_invasion_mexico')]"
				}
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'ccim_requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'ccim_requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'ccim_requirements_toggled' ))]"
			}
		}

		# Mesoamerican Confederation card — shows leader flag and member flags
		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'ccim_confederation_toggled' )]"
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'ccim_confederation_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'ccim_confederation_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'ccim_confederation_toggled' ))]"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/alerts_icons/international_organization.dds"
			}
			blockoverride "header_text" {
				text = "CCIM_CONFEDERATION_PANEL_HEADER"
			}
			blockoverride "bottom_content" {
				datamodel = "[Player.GetDiplomacy.GetInternationalOrganizations]"
				item = {
					scrollarea = {
						visible = "[EqualTo_string(InternationalOrganization.GetType.GetNameKey, 'cc_mesoamerican_confederation')]"
						layoutpolicy_horizontal = expanding
						size = { -1 80 }
						scrollbarpolicy_horizontal = always_off
						scrollbar_vertical = {
							using = Scrollbar_Vertical
						}
						scrollwidget = {
							dynamicgridbox = {
								layoutpolicy_horizontal = expanding
								flipdirection = yes
								position = { 10 10 }
								datamodel_wrap = 14
								maxhorizontalslots = 14
								datamodel = "[InternationalOrganization.GetMembers]"
								item = {
									country_flag_small = {}
								}
							}
						}
					}
				}
			}
		}

		# Situation overview card — describes both sides via static text
		situation_card_header_button = {
			blockoverride "card_header_button_icon_texture" {
				texture = "gfx/interface/icons/diplomatic_status/colonial_nation.dds"
			}
			blockoverride "card_header_button_raw_text" {
				text = "CCIM_SITUATION_OVERVIEW_HEADER"
			}
			blockoverride "bottom_content" {
				text_single = {
					raw_text = "CCIM_SITUATION_OVERVIEW_DESC"
					layoutpolicy_horizontal = expanding
					margin = { 10 8 }
					autoresize = yes
					max_width = 370
				}
			}
		}
	}
}
