				# ---- CC_OFFICE_OPEN_HEADER ----
				text_single = { fontsize = 12  margin_top = 4  text = "CC_OFFICE_OPEN_HEADER" }
				flowcontainer = {
					direction = horizontal
					wrap_count = 2
					ignoreinvisible = yes
					spacing = 6

					# Seneschal
					widget = {
						visible = "[Player.MakeScope.GetVariable('cc_office_seneschal_open').IsSet]"
