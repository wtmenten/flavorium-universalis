					# Speaker of the Elders
					widget = {
						visible = "[And(Not(GetVariableSystem.Exists( 'cc_office_hide_locked' )), Player.MakeScope.GetVariable('cc_office_speaker_of_the_elders_soon').IsSet)]"
						using = cc_office_locked_card
						tooltip = "cc_office_speaker_of_the_elders_tt"
						blockoverride "office_name" { text = "cc_office_speaker_of_the_elders" }
						blockoverride "office_opens" { text = "cc_office_speaker_of_the_elders_opens" }
					}
					# Keeper of the Chronicles
					widget = {
						visible = "[And(Not(GetVariableSystem.Exists( 'cc_office_hide_locked' )), Player.MakeScope.GetVariable('cc_office_keeper_of_regnal_chronicles_soon').IsSet)]"
						using = cc_office_locked_card
						tooltip = "cc_office_keeper_of_regnal_chronicles_tt"
						blockoverride "office_name" { text = "cc_office_keeper_of_regnal_chronicles" }
						blockoverride "office_opens" { text = "cc_office_keeper_of_regnal_chronicles_opens" }
					}
					# Master of the Road
					widget = {
						visible = "[And(Not(GetVariableSystem.Exists( 'cc_office_hide_locked' )), Player.MakeScope.GetVariable('cc_office_master_of_the_silk_road_soon').IsSet)]"
						using = cc_office_locked_card
						tooltip = "cc_office_master_of_the_silk_road_tt"
						blockoverride "office_name" { text = "cc_office_master_of_the_silk_road" }
						blockoverride "office_opens" { text = "cc_office_master_of_the_silk_road_opens" }
					}
					# Master of Ceremonies
					widget = {
						visible = "[And(Not(GetVariableSystem.Exists( 'cc_office_hide_locked' )), Player.MakeScope.GetVariable('cc_office_master_of_ceremonies_soon').IsSet)]"
						using = cc_office_locked_card
						tooltip = "cc_office_master_of_ceremonies_tt"
						blockoverride "office_name" { text = "cc_office_master_of_ceremonies" }
						blockoverride "office_opens" { text = "cc_office_master_of_ceremonies_opens" }
					}
				}

				expand = {}
			}
		}
}
