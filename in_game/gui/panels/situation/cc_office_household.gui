		}

		# ---- Posts held ----
		text_single = { fontsize = 12  text = "CC_OFFICE_HELD_HEADER" }

		# Seneschal
		widget = {
			visible = "[Player.MakeScope.GetVariable('cc_office_seneschal_holder').IsSet]"
			datacontext = "[Player.MakeScope.GetVariable('cc_office_seneschal_holder').GetCharacter]"
			using = cc_office_row
