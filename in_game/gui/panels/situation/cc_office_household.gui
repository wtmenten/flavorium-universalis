######################################################################
# GENERATED FILE. Do not edit by hand.
#   python tools/generate_offices.py
#
# The Household tab of the Court Ledger: one card per office, in a two-column grid.
#
# WHY ONE BLOCK PER OFFICE RATHER THAN GENERIC SLOTS. Which posts exist depends on what the
# realm has researched, so a generic slot would still need a number-to-name mapping in GUI,
# which is the same 43 visibility checks with an extra indirection on top.
#
# WHY IT NEEDS PUBLISHED VARIABLES. GUI cannot ask whether a named advance has been
# researched (IsResearched exists only on the advances screen's own datamodel) and cannot
# read a script value. cc_office_publish_roster pushes out, per office: _open (vacant),
# _soon (its advance can be researched now), _retiring (the advance that ends it can be
# researched now), and for a held office _scale_var and _tenure.
#
# THE GRID is a flowcontainer with wrap_count = 2 and ignoreinvisible = yes, which reflows
# the visible cards into two columns and skips the hidden ones (vanilla: game_rules.gui).
#
# Properties in a template are declared at top level, not wrapped in a widget:
# `using = <template>` merges a template's contents into the widget it is used on, and an
# extra layer collapses to zero size and takes its children's mouse input with it.
######################################################################

# A held office. Expects its holder as the Character datacontext (cc_office_<key>_holder).
template cc_office_held_card {
	size = { 230 186 }
	background = { using = color_whiteish_texture  alpha = 0.10 }

	vbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		margin = { 8 6 }
		spacing = 3

		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 4
			text_single = {
				fontsize = 14
				align = left|nobaseline
				block "office_name" {}
			}
			expand = {}
			block "office_retiring" {}
			block "office_button" {}
		}
		text_single = {
			layoutpolicy_horizontal = expanding
			fontsize = 10
			default_format = "#weak"
			align = left|nobaseline
			block "office_family" {}
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 6
			portrait_standard_head_framed_button = {
				size = { 38 44 }
				onclick = "[ShowCharacter(Character.Self)]"
			}
			vbox = {
				layoutpolicy_horizontal = expanding
				text_single = { layoutpolicy_horizontal = expanding  fontsize = 12  align = left|nobaseline  text = "[Character.GetShortNameWithNoTooltip]" }
				text_single = { layoutpolicy_horizontal = expanding  fontsize = 10  default_format = "#weak"  align = left|nobaseline  text = "CC_OFFICE_CARD_SENIORITY" }
				text_single = {
					layoutpolicy_horizontal = expanding
					fontsize = 10
					default_format = "#weak"
					align = left|nobaseline
					block "office_tenure" {}
				}
			}
		}

		# Effects at the strength this holder gives them.
		text_multi = {
			layoutpolicy_horizontal = expanding
			autoresize = yes
			multiline = yes
			max_width = 212
			fontsize = 11
			block "office_effects" {}
		}
		text_single = {
			layoutpolicy_horizontal = expanding
			fontsize = 10
			default_format = "#weak"
			align = left|nobaseline
			block "office_scale" {}
		}

		expand = {}
	}
}

# An office the realm has but nobody holds.
template cc_office_open_card {
	size = { 230 140 }
	background = { using = color_black_texture  alpha = 0.18 }

	vbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		margin = { 8 6 }
		spacing = 3

		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 4
			text_single = {
				fontsize = 14
				default_format = "#weak"
				align = left|nobaseline
				block "office_name" {}
			}
			expand = {}
			block "office_retiring" {}
			block "office_button" {}
		}
		text_single = {
			layoutpolicy_horizontal = expanding
			fontsize = 10
			default_format = "#weak"
			align = left|nobaseline
			block "office_family" {}
		}

		# Base effects, as a seniority 1 holder would give them.
		text_multi = {
			layoutpolicy_horizontal = expanding
			autoresize = yes
			multiline = yes
			max_width = 212
			fontsize = 11
			block "office_effects" {}
		}
		text_single = {
			layoutpolicy_horizontal = expanding
			fontsize = 10
			default_format = "#weak"
			align = left|nobaseline
			block "office_requirement" {}
		}

		expand = {}
	}
}

# An office this realm can open by researching one advance now.
template cc_office_locked_card {
	size = { 230 58 }
	background = { using = color_black_texture  alpha = 0.12 }

	vbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		margin = { 8 5 }
		spacing = 1
		text_single = {
			layoutpolicy_horizontal = expanding
			fontsize = 12
			default_format = "#weak"
			align = left|nobaseline
			block "office_name" {}
		}
		text_single = {
			layoutpolicy_horizontal = expanding
			fontsize = 10
			default_format = "#weak"
			align = left|nobaseline
			block "office_opens" {}
		}
		expand = {}
	}
}

template cc_office_household_content {
	using = layoutpolicy_expanding
	scrollbarpolicy_horizontal = always_off
	autoresizeviewport = yes
	viewportwidget = {
		widget = {
			scissor = yes
		}
	}
	scrollbar_vertical = {
		using = Scrollbar_Vertical
	}
		scrollwidget = {
			vbox = {
				layoutpolicy_horizontal = expanding
				using = bg_secondary_inner_alt
				margin = { 10 8 }
				spacing = 6

				# ---- Summary ----
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					text_single = { fontsize = 12  default_format = "#weak"  text = "CC_OFFICE_FILLED_LABEL" }
					text_single = {
						fontsize = 15
						raw_text = "[FixedPointToInt(Player.MakeScope.GetVariable('cc_office_filled_var').GetValue)]/6"
						tooltip = "CC_OFFICE_FILLED_TT"
					}
					expand = {}
					icon = {
						size = { 20 20 }
						texture = "gfx/interface/icons/flat_icons/tabicons/info_flat_icon.dds"
						texture_density = 2
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_text" { text = "CC_OFFICE_TAB_HOUSEHOLD" }
								blockoverride "tooltip_content" {
									text_multi = { autoresize = yes  multiline = yes  max_width = 330  text = "CC_OFFICE_TAB_NOTE" }
								}
							}
						}
					}
				}

				# ---- CC_OFFICE_HELD_HEADER ----
				text_single = { fontsize = 12  margin_top = 4  text = "CC_OFFICE_HELD_HEADER" }
				flowcontainer = {
					direction = horizontal
					wrap_count = 2
					ignoreinvisible = yes
					spacing = 6

					# Seneschal
					widget = {
						visible = "[Player.MakeScope.GetVariable('cc_office_seneschal_holder').IsSet]"
						datacontext = "[Player.MakeScope.GetVariable('cc_office_seneschal_holder').GetCharacter]"
						using = cc_office_held_card
						tooltip = "cc_office_seneschal_tt"
						blockoverride "office_name" { text = "cc_office_seneschal" }
						blockoverride "office_family" { text = "CC_OFFICE_FAMILY_CORE" }
						blockoverride "office_tenure" { text = "cc_office_seneschal_tenure_line" }
						blockoverride "office_effects" { text = "cc_office_seneschal_fx_held" }
						blockoverride "office_scale" { text = "cc_office_seneschal_scale_line" }
						blockoverride "office_retiring" {
							text_single = { fontsize = 10  align = right|nobaseline  visible = "[Player.MakeScope.GetVariable('cc_office_seneschal_retiring').IsSet]"  text = "CC_OFFICE_RETIRING"  tooltip = "cc_office_seneschal_retiring_tt" }
						}
						blockoverride "office_button" {
							card_header_button_01 = {
								size = { 30 26 }
								scripted_action_tooltip = {
									click_type = left
									click_mode = single
									action_name = "cc_office_seneschal_dismiss"
									actor = "[Player]"
								}
								enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
								tooltipwidget = { using = action_tooltip_pop_out }
								icon = {
									parentanchor = center
									size = { 20 20 }
									texture = "gfx/interface/icons/modifier_types/blocked_from_cabinet.dds"
								}
							}
						}
					}
					# Master of Coin
					widget = {
						visible = "[Player.MakeScope.GetVariable('cc_office_master_of_coin_holder').IsSet]"
						datacontext = "[Player.MakeScope.GetVariable('cc_office_master_of_coin_holder').GetCharacter]"
						using = cc_office_held_card
						tooltip = "cc_office_master_of_coin_tt"
						blockoverride "office_name" { text = "cc_office_master_of_coin" }
						blockoverride "office_family" { text = "CC_OFFICE_FAMILY_CORE" }
						blockoverride "office_tenure" { text = "cc_office_master_of_coin_tenure_line" }
						blockoverride "office_effects" { text = "cc_office_master_of_coin_fx_held" }
						blockoverride "office_scale" { text = "cc_office_master_of_coin_scale_line" }
