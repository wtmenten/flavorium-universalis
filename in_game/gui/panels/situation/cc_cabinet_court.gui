######################################################################
# Flavorium Universalis — The Court Ledger
#
# Situation panel for the cabinet experience system. Shows every seated minister and
# every sponsored protege with their seniority level, progress toward the next level,
# and their tier in each of the three tracks, plus buttons to act on each of them.
#
# The row layout lives in cc_xp_court_row.gui, which defines the `cc_xp_court_row`
# template used below. Panel chrome here, per-person layout there.
#
# WHY FIXED SLOTS RATHER THAN A DATAMODEL. There is no cabinet datamodel reachable from
# a situation panel: GovernmentView.GetCabinets exists only while the government lateral
# view is open, and Player.GetGovernment exposes estates, parliament, ruler and laws but
# no cabinet list. Sponsored proteges are worse still, being in no list anywhere. So the
# script side publishes numbered character references onto the viewing country
# (cc_xp_sync_slots / cc_xp_sync_proteges in scripted_effects/cc_xp_effects.txt) and this
# panel reads them back with GetVariable(...).GetCharacter, exactly as vanilla does for
# pretenders in panels/disaster/byzantine_succession_crisis.gui.
#
# The consequence is that the slot count is FIXED AND DUPLICATED between script and GUI:
# ten cabinet slots and three protege slots. If cc_xp_effects.txt ever publishes more,
# they must be added here too or they simply will not show.
#
# Everything is read through Player.MakeScope, so a court only ever sees its own people.
# Touches no vanilla file.
######################################################################


######################################################################
# THE PANEL
######################################################################

situation_panel = {

	##################################### MAIN IMAGE #####################################
	# DELIBERATELY NOT OVERRIDDEN. The default block in
	# game/in_game/gui/panels/situation/common.gui:113 calls
	# GetSituationIllustration(...), which resolves
	# main_menu/gfx/interface/illustrations/situation/<situation key>.dds by naming
	# convention alone (no .gfx declaration step), then applies scene_fade_vertical_up.
	# Our art is at that path as cc_cabinet_court.dds, so inheriting the default is all
	# that is needed. This panel previously overrode the block with a flat colour
	# gradient, which is why the illustration never appeared: the override replaced the
	# only call site.

	blockoverride "situation_subheader_content" {}
	# These situations never end, so the vanilla outcomes section (situation_outcomes, in
	# panels/situation/common.gui) has nothing to show: removed.
	blockoverride "situation_panel_main_content_top" {}
	# The vanilla actions card lists every situation-type action that targets this situation.
	# The only ones are the per-slot party actions (cc_pty_<action>_<slot>), which already
	# have their own bar on the Factions tab; listed here they repeat under generic names.
	blockoverride "situation_panel_main_actions" {}

	##################################### MAIN CONTENT #####################################

	blockoverride "situation_panel_main_content" {

		# Header card
		vbox = {
			layoutpolicy_horizontal = expanding
			size = { 510 40 }
			using = bg_card_header_01_government
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 6
				margin = { 10 0 }
				icon = {
					size = { 24 24 }
					texture = "gfx/interface/icons/character_roles/cabinet.dds"
					texture_density = 2
				}
				text_single = {
					fontsize = 16
					text = "CC_XP_COURT_HEADER"
				}
				expand = {}
				icon = {
					size = { 20 20 }
					texture = "gfx/interface/icons/flat_icons/tabicons/info_flat_icon.dds"
					texture_density = 2
					tooltipwidget = {
						ContextualTooltipType = {
							blockoverride "title_text" { text = "CC_XP_COURT_HEADER" }
							blockoverride "tooltip_content" {
								text_multi = { autoresize = yes  multiline = yes  max_width = 330  text = "CC_XP_COURT_DESC" }
							}
						}
					}
				}
			}
		}

		# The panel's OWN scrollarea already wraps situation_panel_main_content
		# (game/in_game/gui/panels/situation/common.gui:230-258), so there is deliberately
		# no scrollarea here. Nesting one swallowed all mouse input: the rows rendered but
		# nothing in them was clickable. Vanilla panels that DO nest a scrollarea declare
		# autoresizeviewport plus an explicit viewportwidget with scissor = yes
		# (guelphs_and_ghibellines.gui:1245); not nesting at all is simpler and safer.
		# Cabinet experience off (factions on): the roster has nothing to show. cc_xp_off is
		# published by the factions yearly update, since GUI cannot read a game rule.
		text_multi = {
			layoutpolicy_horizontal = expanding
			visible = "[Not(Not(Player.MakeScope.GetVariable('cc_xp_off').IsSet))]"
			autoresize = yes
			multiline = yes
			max_width = 480
			margin = { 10 10 }
			fontsize = 12
			default_format = "#weak"
			text = "CC_PTY_LEDGER_XP_OFF"
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			visible = "[Not(Player.MakeScope.GetVariable('cc_xp_off').IsSet)]"
			spacing = 4

			# ---------------- THE CABINET ----------------
			# ---- The one court-level action ----
			#
			# ONLY actions that need no target at all can live up here. A panel
			# action_button cannot open an interaction's select_trigger picker: the engine
			# evaluates the action against the parameters the button supplies, so a
			# target_flag that is never supplied leaves the action unperformable and the
			# button permanently disabled, its tooltip showing only the effect text and the
			# price. Six buttons sat here doing exactly that.
			#
			# Everything that acts on one person moved to that person's row, which supplies
			# `recipient`. Sponsoring a protege stayed because its candidates are courtiers,
			# who are on no row anywhere; it now takes no parameter and offers the
			# candidates as options in cc_xp.85.
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4
				card_header_button_01 = {
					size = { 150 26 }
					scripted_action_tooltip = {
						click_type = left
						click_mode = single
						action_name = "cc_xp_sponsor_protege"
						actor = "[Player]"
					}
					enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
					tooltipwidget = { using = action_tooltip_pop_out }
					text_single = {
						parentanchor = center
						align = center
						fontsize = 10
						text = "CC_XP_BTN_PROTEGE"
					}
				}
				expand = {}
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				fontsize = 12
				default_format = "#weak"
				text = "CC_XP_SECTION_CABINET"
			}

			# Ten fixed slots. See the file header for why these are not a datamodel.
			widget = { visible = "[Player.MakeScope.GetVariable('cc_xp_slot_1').IsSet]"   datacontext = "[Player.MakeScope.GetVariable('cc_xp_slot_1').GetCharacter]"   using = cc_xp_court_row }
			widget = { visible = "[Player.MakeScope.GetVariable('cc_xp_slot_2').IsSet]"   datacontext = "[Player.MakeScope.GetVariable('cc_xp_slot_2').GetCharacter]"   using = cc_xp_court_row }
			widget = { visible = "[Player.MakeScope.GetVariable('cc_xp_slot_3').IsSet]"   datacontext = "[Player.MakeScope.GetVariable('cc_xp_slot_3').GetCharacter]"   using = cc_xp_court_row }
			widget = { visible = "[Player.MakeScope.GetVariable('cc_xp_slot_4').IsSet]"   datacontext = "[Player.MakeScope.GetVariable('cc_xp_slot_4').GetCharacter]"   using = cc_xp_court_row }
			widget = { visible = "[Player.MakeScope.GetVariable('cc_xp_slot_5').IsSet]"   datacontext = "[Player.MakeScope.GetVariable('cc_xp_slot_5').GetCharacter]"   using = cc_xp_court_row }
			widget = { visible = "[Player.MakeScope.GetVariable('cc_xp_slot_6').IsSet]"   datacontext = "[Player.MakeScope.GetVariable('cc_xp_slot_6').GetCharacter]"   using = cc_xp_court_row }
			widget = { visible = "[Player.MakeScope.GetVariable('cc_xp_slot_7').IsSet]"   datacontext = "[Player.MakeScope.GetVariable('cc_xp_slot_7').GetCharacter]"   using = cc_xp_court_row }
			widget = { visible = "[Player.MakeScope.GetVariable('cc_xp_slot_8').IsSet]"   datacontext = "[Player.MakeScope.GetVariable('cc_xp_slot_8').GetCharacter]"   using = cc_xp_court_row }
			widget = { visible = "[Player.MakeScope.GetVariable('cc_xp_slot_9').IsSet]"   datacontext = "[Player.MakeScope.GetVariable('cc_xp_slot_9').GetCharacter]"   using = cc_xp_court_row }
			widget = { visible = "[Player.MakeScope.GetVariable('cc_xp_slot_10').IsSet]"  datacontext = "[Player.MakeScope.GetVariable('cc_xp_slot_10').GetCharacter]"  using = cc_xp_court_row }

			# ---------------- PROTEGES ----------------
			text_single = {
				layoutpolicy_horizontal = expanding
				fontsize = 12
				default_format = "#weak"
				margin_top = 8
				text = "CC_XP_SECTION_PROTEGES"
			}

			# Shown only when there are none, so the section never looks broken.
			text_single = {
				layoutpolicy_horizontal = expanding
				fontsize = 11
				default_format = "#weak"
				visible = "[Not(Player.MakeScope.GetVariable('cc_xp_protege_1').IsSet)]"
				text = "CC_XP_NO_PROTEGES"
			}

			widget = { visible = "[Player.MakeScope.GetVariable('cc_xp_protege_1').IsSet]"  datacontext = "[Player.MakeScope.GetVariable('cc_xp_protege_1').GetCharacter]"  using = cc_xp_court_row }
			widget = { visible = "[Player.MakeScope.GetVariable('cc_xp_protege_2').IsSet]"  datacontext = "[Player.MakeScope.GetVariable('cc_xp_protege_2').GetCharacter]"  using = cc_xp_court_row }
			widget = { visible = "[Player.MakeScope.GetVariable('cc_xp_protege_3').IsSet]"  datacontext = "[Player.MakeScope.GetVariable('cc_xp_protege_3').GetCharacter]"  using = cc_xp_court_row }
		}
	}


	##################################### EXTRA TABS #####################################
	#
	# The roster above is the DEFAULT tab: common.gui shows situation_panel_main_content
	# whenever situation_tab NotExistOrHasValue 'situation_breakdown', so it needs no
	# button of its own. These two add themselves alongside it.
	#
	# Tab state is a view variable (SituationView.Vars), not a country variable, so it is
	# per-viewer and per-session and costs the save nothing.
	######################################################################################

	blockoverride "situation_extra_tabs_content" {

		button_secondary_tab_alt = {
			using = layoutpolicy_expanding
			visible = "[Not(Player.MakeScope.GetVariable('cc_xp_off').IsSet)]"
			blockoverride "tab_text" { text = "CC_XP_TAB_PATRONAGE" }
			action_tooltip = {
				title = "OPEN_TAB"
				on_action = "[SituationView.Vars.Set( 'situation_tab', 'cc_xp_patronage' )]"
			}
			down = "[SituationView.Vars.HasValue( 'situation_tab', 'cc_xp_patronage' )]"
		}

		button_secondary_tab_alt = {
			using = layoutpolicy_expanding
			visible = "[Not(Player.MakeScope.GetVariable('cc_xp_off').IsSet)]"
			blockoverride "tab_text" { text = "CC_XP_TAB_SCHOOLS" }
			action_tooltip = {
				title = "OPEN_TAB"
				on_action = "[SituationView.Vars.Set( 'situation_tab', 'cc_xp_schools' )]"
			}
			down = "[SituationView.Vars.HasValue( 'situation_tab', 'cc_xp_schools' )]"
		}

		button_secondary_tab_alt = {
			using = layoutpolicy_expanding
			visible = "[Not(Player.MakeScope.GetVariable('cc_xp_off').IsSet)]"
			blockoverride "tab_text" { text = "CC_OFFICE_TAB_HOUSEHOLD" }
			action_tooltip = {
				title = "OPEN_TAB"
				on_action = "[SituationView.Vars.Set( 'situation_tab', 'cc_office_household' )]"
			}
			down = "[SituationView.Vars.HasValue( 'situation_tab', 'cc_office_household' )]"
		}

		# Factions (rule cc_factions): shown while the realm has parties.
		button_secondary_tab_alt = {
			using = layoutpolicy_expanding
			visible = "[Player.MakeScope.GetVariable('cc_pty_active').IsSet]"
			blockoverride "tab_text" { text = "cc_pty_factions" }
			action_tooltip = {
				title = "OPEN_TAB"
				on_action = "[SituationView.Vars.Set( 'situation_tab', 'cc_pty_factions' )]"
			}
			down = "[SituationView.Vars.HasValue( 'situation_tab', 'cc_pty_factions' )]"
		}
	}
	blockoverride "situation_extra_tab_panels" {

		################################ PATRONAGE ################################
		#
		# Summary and panel actions, the artist roster, then every work the realm holds.
		#
		# Extra tab panels sit OUTSIDE the panel's own scrollarea (common.gui:368, after the
		# scrollarea at 243 closes), so each tab brings its own. It is not nested in another
		# scrollarea, which is what swallowed input on the roster tab before.
		#
		# Artists come from the Country.GetLivingArtistsForUI datamodel. Works come from
		# cc_xp_art_locs, a list of the owned locations holding art that cc_xp_publish_art
		# republishes monthly, walked through Location.GetWorksOfArt: there is no country
		# works datamodel. See docs/scripting-gotchas.md, "Works of art and artists in GUI".
		###########################################################################
		scrollarea = {
			visible = "[SituationView.Vars.HasValue( 'situation_tab', 'cc_xp_patronage' )]"
			using = layoutpolicy_expanding
			scrollbarpolicy_horizontal = always_off
			autoresizeviewport = yes
			viewportwidget = {
				widget = {
					scissor = yes
				}
			}
			scrollbar_vertical = {
				using = Scrollbar_Vertical
			}

			scrollwidget = {
				vbox = {
					layoutpolicy_horizontal = expanding
					using = bg_secondary_inner_alt
					margin = { 10 8 }
					spacing = 6

					# ---- Summary ----
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4

						hbox = {
							spacing = 4
							datacontext = "[Player]"
							tooltipwidget = { using = WorksOfArt_tooltip }
							text_single = { fontsize = 12  default_format = "#weak"  text = "CC_XP_WORKS_LABEL" }
							text_single = { fontsize = 15  raw_text = "[Player.GetNumWorksOfArt]" }
						}
						widget = { size = { 14 1 } }
						text_single = { fontsize = 12  default_format = "#weak"  text = "CC_XP_ARTISTS_LABEL" }
						text_single = { fontsize = 15  raw_text = "[GetDataModelSize(Player.GetLivingArtistsForUI)]" }
						widget = { size = { 14 1 } }
						text_single = { fontsize = 12  default_format = "#weak"  text = "CC_XP_SPONSORED_LABEL" }
						text_single = { fontsize = 15  raw_text = "[Player.MakeScope.GetVariable('cc_xp_sponsored_artists').GetValue|0]"  tooltip = "CC_XP_SPONSORED_TT" }

						expand = {}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4

						# No parameter is supplied: both of this interaction's targets are chosen
						# among options in cc_xp.84.
						card_header_button_01 = {
							size = { 150 26 }
							scripted_action_tooltip = {
								click_type = left
								click_mode = single
								action_name = "cc_xp_sell_art_discreetly"
								actor = "[Player]"
							}
							enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
							tooltipwidget = { using = action_tooltip_pop_out }
							text_single = {
								parentanchor = center
								align = center
								fontsize = 11
								text = "CC_XP_BTN_SELL_WORK"
							}
						}

						# Vanilla's own sortable works list, for everything this tab does not do.
						card_header_button_01 = {
							size = { 150 26 }
							onclick = "[OpenLateralView('arts_overview')]"
							tooltip = "CC_XP_BTN_OPEN_ARTS_TT"
							text_single = {
								parentanchor = center
								align = center
								fontsize = 11
								text = "CC_XP_BTN_OPEN_ARTS"
							}
						}

						expand = {}
					}

					# ---- Artists ----
					text_single = {
						layoutpolicy_horizontal = expanding
						fontsize = 11
						default_format = "#weak"
						align = left|nobaseline
						margin_top = 4
						text = "CC_XP_ARTISTS_HEADER"
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						fontsize = 11
						default_format = "#weak"
						align = left|nobaseline
						visible = "[IsDataModelEmpty(Player.GetLivingArtistsForUI)]"
						text = "CC_XP_NO_ARTISTS"
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 3
						datamodel = "[Player.GetLivingArtistsForUI]"
						item = {
							widget = {
								layoutpolicy_horizontal = expanding
								size = { -1 66 }
								background = { using = color_whiteish_texture  alpha = 0.10 }

								hbox = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									margin = { 6 4 }
									spacing = 6

									portrait_standard_head_framed_button = {
										size = { 42 48 }
										onclick = "[ShowCharacter(Character.Self)]"
									}

									vbox = {
										layoutpolicy_horizontal = expanding
										spacing = 1

										# Name, art form, skill.
										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 5
											text_single = { fontsize = 13  align = left|nobaseline  text = "[Character.GetShortNameWithNoTooltip]" }
											text_single = { fontsize = 10  default_format = "#weak"  align = left|nobaseline  text = "[Character.GetArtistType.GetNameWithNoTooltip]" }
											text_single = { fontsize = 10  default_format = "#weak"  align = left|nobaseline  raw_text = "[Character.GetArtistSkill]"  tooltip = "CC_XP_ARTIST_SKILL_TT" }
											expand = {}
										}

										# Patron.
										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 4
											text_single = {
												fontsize = 10
												align = left|nobaseline
												visible = "[Character.MakeScope.GetVariable('cc_xp_patron').IsSet]"
												text = "CC_XP_ARTIST_PATRON"
												tooltip = "CC_XP_HAS_PATRON_TT"
											}
											text_single = {
												fontsize = 10
												default_format = "#weak"
												align = left|nobaseline
												visible = "[Not(Character.MakeScope.GetVariable('cc_xp_patron').IsSet)]"
												text = "CC_XP_ARTIST_NO_PATRON"
											}
											expand = {}
										}

										# The piece in hand. Three states, measured in game:
										#   working     HasArtInProgress, progress above 0
										#   stalled     HasArtInProgress, progress exactly 0. Pieces do not
										#               advance at all before the realm can invest in
										#               culture, and a new piece starts at 0
										#   idle        not HasArtInProgress
										# Not the piece's name: StringIsEmpty returns false for it even when
										# it renders empty. See docs/scripting-gotchas.md.
										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 5
											visible = "[And(Character.HasArtInProgress, GreaterThan_CFixedPoint(Character.GetArtProgress, '(CFixedPoint)0'))]"
											tooltip = "[Character.GetArtProgressInfo]"
											text_single = { fontsize = 10  align = left|nobaseline  text = "CC_XP_ARTIST_WORKING" }
											widget = {
												size = { 110 8 }
												progressbar = {
													size = { 100% 100% }
													noprogresstexture = "gfx/interface/progressbars/progress_bar_grey_alt.dds"
													progresstexture = "gfx/interface/progressbars/progress_bar_goldish.dds"
													texture_density = 2
													spriteType = Corneredstretched
													spriteborder = { 12 0 }
													min = 0
													max = 1
													value = "[FixedPointToFloat(Character.GetArtProgress)]"
												}
											}
											text_single = { fontsize = 10  align = left|nobaseline  raw_text = "[Character.GetArtProgress|%0Y]" }
											expand = {}
										}
										text_single = {
											layoutpolicy_horizontal = expanding
											fontsize = 10
											align = left|nobaseline
											visible = "[And(Character.HasArtInProgress, Not(GreaterThan_CFixedPoint(Character.GetArtProgress, '(CFixedPoint)0')))]"
											text = "CC_XP_ARTIST_STALLED"
											tooltip = "CC_XP_ARTIST_STALLED_TT"
										}
										text_single = {
											layoutpolicy_horizontal = expanding
											fontsize = 10
											default_format = "#weak"
											align = left|nobaseline
											visible = "[Not(Character.HasArtInProgress)]"
											text = "CC_XP_ARTIST_IDLE"
											tooltip = "CC_XP_ARTIST_IDLE_TT"
										}
									}

									# Works completed by this artist.
									text_single = {
										fontsize = 11
										default_format = "#weak"
										raw_text = "[GetDataModelSize(Character.GetWorksOfArt)]"
										tooltip = "CC_XP_WORKS_BY_TT"
									}

									# Sponsorship, our studio visit, then vanilla's two art
									# interactions. All four take target_flag = recipient and want a
									# character, so the artist under the cursor IS the parameter and
									# none needs a picker step.
									card_header_button_01 = {
										size = { 26 26 }
										scripted_action_tooltip = {
											click_type = left
											click_mode = single
											action_name = "cc_xp_sponsor_artist"
											actor = "[Player]"
											parameter = {
												parameter_name = "recipient"
												parameter_value = "[Character.MakeScope]"
											}
										}
										enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
										tooltipwidget = { using = action_tooltip_pop_out }
										icon = {
											parentanchor = center
											size = { 78% 78% }
											texture = "gfx/interface/icons/flat_icons/prestige.dds"
										}
									}

									card_header_button_01 = {
										size = { 26 26 }
										scripted_action_tooltip = {
											click_type = left
											click_mode = single
											action_name = "cc_xp_studio_visit"
											actor = "[Player]"
											parameter = {
												parameter_name = "recipient"
												parameter_value = "[Character.MakeScope]"
											}
										}
										enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
										tooltipwidget = { using = action_tooltip_pop_out }
										icon = {
											parentanchor = center
											size = { 78% 78% }
											texture = "gfx/interface/icons/flat_icons/work_of_art_in_progress.dds"
										}
									}

									card_header_button_01 = {
										size = { 26 26 }
										scripted_action_tooltip = {
											click_type = left
											click_mode = single
											action_name = "commission_art"
											actor = "[Player]"
											parameter = {
												parameter_name = "recipient"
												parameter_value = "[Character.MakeScope]"
											}
										}
										enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
										tooltipwidget = { using = action_tooltip_pop_out }
										icon = {
											parentanchor = center
											size = { 78% 78% }
											texture = "gfx/interface/icons/flat_icons/art_works.dds"
										}
									}

									card_header_button_01 = {
										size = { 26 26 }
										scripted_action_tooltip = {
											click_type = left
											click_mode = single
											action_name = "dismiss_artist"
											actor = "[Player]"
											parameter = {
												parameter_name = "recipient"
												parameter_value = "[Character.MakeScope]"
											}
										}
										enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
										tooltipwidget = { using = action_tooltip_pop_out }
										icon = {
											parentanchor = center
											size = { 72% 72% }
											texture = "gfx/interface/buttons/flats/remove.dds"
										}
									}
								}
							}
						}
					}

					# ---- Works of art ----
					# The eye hides what Sell a Work will not offer (cc_xp.84): priceless works, and
					# monuments, palaces, temple towers, regalia and mansions. Keep the two lists in
					# step. The toggle is a view variable, per viewer and unsaved.
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 6
						spacing = 4
						text_single = {
							fontsize = 11
							default_format = "#weak"
							align = left|nobaseline
							text = "CC_XP_WORKS_HEADER"
						}
						expand = {}
						card_header_button_01 = {
							size = { 26 26 }
							onclick = "[GetVariableSystem.Toggle( 'cc_xp_hide_fixed_art' )]"
							tooltip = "CC_XP_ART_TOGGLE_FIXED_TT"
							icon = {
								using = color_white_texture
								alpha = 0.3
								size = { 100% 100% }
								visible = "[GetVariableSystem.Exists( 'cc_xp_hide_fixed_art' )]"
							}
							icon = {
								parentanchor = center
								size = { 20 20 }
								texture = "gfx/interface/icons/flat_icons/building_panel/build_visible.dds"
							}
						}
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						fontsize = 11
						default_format = "#weak"
						align = left|nobaseline
						visible = "[IsDataModelEmpty(Player.MakeScope.GetList('cc_xp_art_locs'))]"
						text = "CC_XP_NO_WORKS"
					}

					# Column headings, sized to match the rows below.
					hbox = {
						layoutpolicy_horizontal = expanding
						visible = "[DataModelHasItems(Player.MakeScope.GetList('cc_xp_art_locs'))]"
						margin = { 6 0 }
						spacing = 6
						widget = { size = { 22 1 } }
						text_single = { layoutpolicy_horizontal = expanding  size = { 120 18 }  autoresize = no  fontsize = 10  default_format = "#weak"  align = left|nobaseline  text = "CC_XP_ART_COL_NAME" }
						text_single = { size = { 64 18 }  autoresize = no  fontsize = 10  default_format = "#weak"  align = left|nobaseline  text = "CC_XP_ART_COL_TYPE" }
						text_single = { size = { 56 18 }  autoresize = no  fontsize = 10  default_format = "#weak"  align = left|nobaseline  text = "CC_XP_ART_COL_QUALITY" }
						text_single = { size = { 84 18 }  autoresize = no  fontsize = 10  default_format = "#weak"  align = left|nobaseline  text = "CC_XP_ART_COL_ARTIST" }
						text_single = { size = { 70 18 }  autoresize = no  fontsize = 10  default_format = "#weak"  align = left|nobaseline  text = "CC_XP_ART_COL_LOCATION" }
					}

					# One block per location, one row per work in it.
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 2
						datamodel = "[Player.MakeScope.GetList('cc_xp_art_locs')]"
						item = {
							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 2
								datacontext = "[Scope.GetLocation]"
								datamodel = "[Location.GetWorksOfArt]"
								item = {
									widget = {
										layoutpolicy_horizontal = expanding
										size = { -1 28 }
										background = { using = color_whiteish_texture  alpha = 0.06 }
										# The type is matched by comparing its plain name with vanilla's loc
										# key for that type, so it works in any language. Measured in game:
										# GetNameWithNoTooltip compares, GetName never matches (it carries
										# tooltip markup), GetWorkOfArtIcon is a texture with no string
										# value, and GetKey does not exist on this type.
										visible = "[Or(Not(GetVariableSystem.Exists( 'cc_xp_hide_fixed_art' )), Not(Or(WorkOfArt.IsPriceless, Or(EqualTo_string(WorkOfArt.GetDefinition.GetNameWithNoTooltip, Localize('monument')), Or(EqualTo_string(WorkOfArt.GetDefinition.GetNameWithNoTooltip, Localize('palace')), Or(EqualTo_string(WorkOfArt.GetDefinition.GetNameWithNoTooltip, Localize('temple_tower')), Or(EqualTo_string(WorkOfArt.GetDefinition.GetNameWithNoTooltip, Localize('regalia')), EqualTo_string(WorkOfArt.GetDefinition.GetNameWithNoTooltip, Localize('mansion')))))))))]"

										hbox = {
											layoutpolicy_horizontal = expanding
											layoutpolicy_vertical = expanding
											margin = { 6 0 }
											spacing = 6

											icon = {
												size = { 22 22 }
												texture = "[GetWorkOfArtIcon(WorkOfArt.GetDefinition)]"
											}
											text_single = {
												layoutpolicy_horizontal = expanding
												size = { 120 20 }
												autoresize = no
												fontsize = 12
												default_format = "#yellow_titles"
												align = left|nobaseline
												text = "[WorkOfArt.GetNameWithNoTooltip]"
												tooltipwidget = { using = WorkOfArt_tooltip }
											}
											text_single = {
												size = { 64 20 }
												autoresize = no
												fontsize = 11
												align = left|nobaseline
												text = "[WorkOfArt.GetDefinition.GetName]"
											}
											text_single = {
												size = { 56 20 }
												autoresize = no
												fontsize = 11
												align = left|nobaseline
												text = "[WorkOfArt.GetQualityName]"
												tooltipwidget = { using = QualityOfArt_tooltip }
											}
											icon = {
												size = { 14 14 }
												visible = "[WorkOfArt.IsPriceless]"
												texture = "gfx/interface/icons/flat_icons/prestige.dds"
												tooltip = "CC_XP_ART_PRICELESS_TT"
											}
											text_single = {
												size = { 84 20 }
												autoresize = no
												fontsize = 11
												align = left|nobaseline
												text = "[WorkOfArt.GetCreatorName]"
											}
											text_single = {
												size = { 70 20 }
												autoresize = no
												fontsize = 11
												default_format = "#weak"
												align = left|nobaseline
												text = "[WorkOfArt.GetLocation.GetNameWithNoTooltip]"
											}
										}
									}
								}
							}
						}
					}

					expand = {}
				}
			}
		}

		################################ SCHOOLS ################################
		#
		# All three slots are drawn at all times, so the ladder of unlocks is visible from
		# the first hour of the game rather than appearing later without explanation.
		#
		# A founded school is a card (cc_xp_school_cards.gui, generated by
		# tools/generate_school_slots.py) carrying its seat, kind, curriculum, founder,
		# Rector, members and its five actions.
		#
		# A slot is founded, open, or locked. Deciding "open" needs the realm's CAPACITY,
		# which is a script value and unreadable from GUI, so cc_xp_publish_school_capacity
		# republishes it monthly as cc_xp_school_capacity_var purely for this comparison.
		#########################################################################
		# Extra tab panels sit outside the panel's own scrollarea (common.gui:368), and three
		# school cards are taller than the panel, so this tab brings its own.
		scrollarea = {
			visible = "[SituationView.Vars.HasValue( 'situation_tab', 'cc_xp_schools' )]"
			using = layoutpolicy_expanding
			scrollbarpolicy_horizontal = always_off
			autoresizeviewport = yes
			viewportwidget = {
				widget = {
					scissor = yes
				}
			}
			scrollbar_vertical = {
				using = Scrollbar_Vertical
			}
			scrollwidget = {
				vbox = {
					layoutpolicy_horizontal = expanding
					using = bg_secondary_inner_alt
					margin = { 10 8 }
					spacing = 6

					# ---- Summary ----
					# The tab's explainer is the info icon at the end of this row.
					# Published monthly by cc_xp_monthly_schools; GUI cannot count members itself.
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4
						text_single = { fontsize = 12  default_format = "#weak"  text = "CC_XP_SCHOOLS_FOUNDED_LABEL" }
						text_single = { fontsize = 15  raw_text = "[Player.MakeScope.GetVariable('cc_xp_school_founded_count').GetValue|0] / [Player.MakeScope.GetVariable('cc_xp_school_capacity_var').GetValue|0]"  tooltip = "CC_XP_SCHOOLS_FOUNDED_TT" }
						widget = { size = { 18 1 } }
						text_single = { fontsize = 12  default_format = "#weak"  text = "CC_XP_SCHOOLS_MEMBERS_LABEL" }
						text_single = { fontsize = 15  raw_text = "[Player.MakeScope.GetVariable('cc_xp_school_total_members').GetValue|0]" }
						expand = {}
						icon = {
							size = { 20 20 }
							texture = "gfx/interface/icons/flat_icons/tabicons/info_flat_icon.dds"
							texture_density = 2
							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_text" { text = "CC_XP_TAB_SCHOOLS" }
									blockoverride "tooltip_content" {
										text_multi = { autoresize = yes  multiline = yes  max_width = 330  text = "CC_XP_SCHOOLS_DESC" }
									}
								}
							}
						}
					}

					# The leading foreign university, found by the yearly rival scan
					# (cc_xp_school_scan_rivals). Renown is measured against it.
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4
						visible = "[Player.MakeScope.GetVariable('cc_xp_school_rival_loc').IsSet]"
						tooltip = "CC_XP_SCHOOLS_RIVAL_TT"
						text_single = { fontsize = 12  default_format = "#weak"  text = "CC_XP_SCHOOLS_RIVAL_LABEL" }
						text_single = {
							fontsize = 13
							datacontext = "[Player.MakeScope.GetVariable('cc_xp_school_rival_loc').GetLocation]"
							raw_text = "[Location.GetNameWithNoTooltip] ([Location.GetOwner.GetNameWithNoTooltip])"
						}
						text_single = { fontsize = 12  default_format = "#weak"  raw_text = "[Player.MakeScope.GetVariable('cc_xp_school_rival_score').GetValue|0]" }
						expand = {}
					}

					# Founding and enrollment both act on ONE minister, so both are row buttons on
					# the roster tab now. They were dead here: a header button supplies no target and
					# an interaction whose target_flag goes unsupplied can never be performed.
					text_single = {
						layoutpolicy_horizontal = expanding
						fontsize = 11
						default_format = "#weak"
						align = left|nobaseline
						text = "CC_XP_SCHOOLS_HEADER"
					}

					# ---------------- SLOT 1 ----------------
					widget = {
						visible = "[Player.MakeScope.GetVariable('cc_xp_school_1_founder').IsSet]"
						using = cc_xp_school_card_1
					}
					widget = {
						visible = "[And(Not(Player.MakeScope.GetVariable('cc_xp_school_1_founder').IsSet), GreaterThanOrEqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_xp_school_capacity_var').GetValue, '(CFixedPoint)1'))]"
						using = cc_xp_school_slot
						blockoverride "slot_state" { text = "CC_XP_SLOT_OPEN" }
						blockoverride "slot_requirement" { text = "CC_XP_SLOT_REQ_1" }
					}
					widget = {
						visible = "[Not(Or(Player.MakeScope.GetVariable('cc_xp_school_1_founder').IsSet, GreaterThanOrEqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_xp_school_capacity_var').GetValue, '(CFixedPoint)1')))]"
						using = cc_xp_school_slot
						blockoverride "slot_state" { text = "CC_XP_SLOT_LOCKED" }
						blockoverride "slot_requirement" { text = "CC_XP_SLOT_REQ_1" }
					}

					# ---------------- SLOT 2 ----------------
					widget = {
						visible = "[Player.MakeScope.GetVariable('cc_xp_school_2_founder').IsSet]"
						using = cc_xp_school_card_2
					}
					widget = {
						visible = "[And(Not(Player.MakeScope.GetVariable('cc_xp_school_2_founder').IsSet), GreaterThanOrEqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_xp_school_capacity_var').GetValue, '(CFixedPoint)2'))]"
						using = cc_xp_school_slot
						blockoverride "slot_state" { text = "CC_XP_SLOT_OPEN" }
						blockoverride "slot_requirement" { text = "CC_XP_SLOT_REQ_2" }
					}
					widget = {
						visible = "[Not(Or(Player.MakeScope.GetVariable('cc_xp_school_2_founder').IsSet, GreaterThanOrEqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_xp_school_capacity_var').GetValue, '(CFixedPoint)2')))]"
						using = cc_xp_school_slot
						blockoverride "slot_state" { text = "CC_XP_SLOT_LOCKED" }
						blockoverride "slot_requirement" { text = "CC_XP_SLOT_REQ_2" }
					}

					# ---------------- SLOT 3 ----------------
					widget = {
						visible = "[Player.MakeScope.GetVariable('cc_xp_school_3_founder').IsSet]"
						using = cc_xp_school_card_3
					}
					widget = {
						visible = "[And(Not(Player.MakeScope.GetVariable('cc_xp_school_3_founder').IsSet), GreaterThanOrEqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_xp_school_capacity_var').GetValue, '(CFixedPoint)3'))]"
						using = cc_xp_school_slot
						blockoverride "slot_state" { text = "CC_XP_SLOT_OPEN" }
						blockoverride "slot_requirement" { text = "CC_XP_SLOT_REQ_3" }
					}
					widget = {
						visible = "[Not(Or(Player.MakeScope.GetVariable('cc_xp_school_3_founder').IsSet, GreaterThanOrEqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_xp_school_capacity_var').GetValue, '(CFixedPoint)3')))]"
						using = cc_xp_school_slot
						blockoverride "slot_state" { text = "CC_XP_SLOT_LOCKED" }
						blockoverride "slot_requirement" { text = "CC_XP_SLOT_REQ_3" }
					}

					expand = {}
				}
			}
		}

		################################ HOUSEHOLD ################################
		#
		# Which posts exist depends on what the realm has researched, so this tab is
		# generated: tools/generate_offices.py writes one block per office into
		# cc_office_household.gui and this is the container that shows it.
		#
		# Like the schools tab, it depends on variables republished for the panel's
		# benefit, because GUI cannot evaluate the underlying condition itself. There it
		# was a script value; here it is `has_advance`, which GUI has no by-key lookup
		# for. cc_office_publish_roster writes cc_office_<key>_open and
		# cc_office_filled_var monthly for human courts.
		#
		# There is no appoint button here. A button supplies no target, so it could not
		# open the interaction's character picker; appointment is done from a minister's
		# own interaction menu. That is the same limitation that moved ten other buttons
		# off this panel. See docs/scripting-gotchas.md.
		###########################################################################
		# The template is a scrollarea's body (see its header in cc_office_household.gui).
		# Mounting it in a plain widget collapses it to zero size and the tab renders empty.
		scrollarea = {
			visible = "[SituationView.Vars.HasValue( 'situation_tab', 'cc_office_household' )]"
			using = cc_office_household_content
		}

		################################ FACTIONS ################################
		#
		# The party chamber, generated by tools/generate_factions.py into
		# cc_pty_factions_tab.gui. Like the Household template it is a scrollarea's body.
		###########################################################################
		scrollarea = {
			visible = "[And(SituationView.Vars.HasValue( 'situation_tab', 'cc_pty_factions' ), Player.MakeScope.GetVariable('cc_pty_active').IsSet)]"
			using = cc_pty_factions_content
		}
	}
}
