{
  "permissions": {
    "allow": [
      "Bash(git -C /e/GenAI/synthetic_minds log --all --format=%ai)",
      "Bash(grep -r \"extends Node\" /e/GenAI/synthetic_minds/autoloads/*.gd)",
      "Bash(git -C /e/GenAI/synthetic_minds remote -v)",
      "Bash(wc -l /e/GenAI/synthetic_minds/autoloads/*.gd)",
      "Bash(wc -l /e/GenAI/synthetic_minds/scenes/**/*.gd)",
      "Bash(grep -E \"\\\\.gd$\")",
      "Bash(ls /e/GenAI/synthetic_minds/scenes/ui/*.gd)",
      "Bash(xargs basename:*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_ATTRIBUTION_HEADER" : "0"
  },
  "syntaxHighlightingDisabled": true,
  "theme": "dark"
}
