					hbox = {
						spacing = 6
				# Sized by its content (resizeparent below): the effects list varies in length.
				widget = {
					visible = "[Player.MakeScope.GetVariable('cc_pty_3_type').IsSet]"
					background = { using = color_whiteish_texture  alpha = 0.10 }

					# Selected: a brighter wash behind the card.
					widget = {
						size = { 100% 100% }
						visible = "[SituationView.Vars.HasValue( 'cc_pty_sel', '3' )]"
						background = { using = color_white_texture  alpha = 0.16 }
					}

					# The whole card selects it; the content sits on top.
					button = {
						size = { 100% 100% }
						onclick = "[SituationView.Vars.Set( 'cc_pty_sel', '3' )]"
						tooltip = "CC_PTY_CARD_SELECT_TT"
					}

					vbox = {
						resizeparent = yes
						# Tall enough for the longest effects list (seven rows), so the two cards
						# in a row line up; a longer list would still grow the card.
						minimumsize = { 196 226 }
						maximumsize = { 196 -1 }
						margin = { 6 4 }
						margin_bottom = 8
						spacing = 2

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 4
							widget = {
								size = { 22 22 }
								icon = { size = { 22 22 }  texture = "gfx/interface/icons/estates/crown_estate.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_3_type').GetValue, '(CFixedPoint)1')]" }
