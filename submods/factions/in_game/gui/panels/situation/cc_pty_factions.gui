					visible = "[Player.MakeScope.GetVariable('cc_pty_4_type').IsSet]"
					background = { using = color_whiteish_texture  alpha = 0.10 }

					# Selected: a brighter wash behind the card.
					widget = {
						size = { 100% 100% }
						visible = "[SituationView.Vars.HasValue( 'cc_pty_sel', '4' )]"
						background = { using = color_white_texture  alpha = 0.16 }
					}

					# The whole card selects it; the content sits on top.
					button = {
						size = { 100% 100% }
						onclick = "[SituationView.Vars.Set( 'cc_pty_sel', '4' )]"
						tooltip = "CC_PTY_CARD_SELECT_TT"
					}

					vbox = {
						resizeparent = yes
						# Tall enough for the longest effects list (seven rows), so the two cards
						# in a row line up; a longer list would still grow the card.
						minimumsize = { 196 226 }
						maximumsize = { 196 -1 }
						margin = { 6 4 }
						margin_bottom = 8
						spacing = 2

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 4
							widget = {
								size = { 22 22 }
								icon = { size = { 22 22 }  texture = "gfx/interface/icons/estates/crown_estate.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_type').GetValue, '(CFixedPoint)1')]" }
								icon = { size = { 22 22 }  texture = "gfx/interface/icons/estates/nobles_estate.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_type').GetValue, '(CFixedPoint)2')]" }
								icon = { size = { 22 22 }  texture = "gfx/interface/icons/estates/burghers_estate.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_type').GetValue, '(CFixedPoint)3')]" }
								icon = { size = { 22 22 }  texture = "gfx/interface/icons/estates/clergy_estate.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_type').GetValue, '(CFixedPoint)4')]" }
								icon = { size = { 22 22 }  texture = "gfx/interface/icons/societal_values/belligerent_vs_conciliatory_left.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_type').GetValue, '(CFixedPoint)5')]" }
								icon = { size = { 22 22 }  texture = "gfx/interface/icons/estates/peasants_estate.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_type').GetValue, '(CFixedPoint)6')]" }
								icon = { size = { 22 22 }  texture = "gfx/interface/icons/societal_values/traditionalist_vs_innovative_right.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_type').GetValue, '(CFixedPoint)7')]" }
								icon = { size = { 22 22 }  texture = "gfx/interface/icons/societal_values/absolutism_vs_liberalism_left.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_type').GetValue, '(CFixedPoint)8')]" }
								icon = { size = { 22 22 }  texture = "gfx/interface/icons/societal_values/centralization_vs_decentralization_right.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_type').GetValue, '(CFixedPoint)9')]" }
								icon = { size = { 22 22 }  texture = "gfx/interface/icons/subject_types/colonial_nation.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_type').GetValue, '(CFixedPoint)10')]" }
								icon = { size = { 22 22 }  texture = "gfx/interface/icons/societal_values/absolutism_vs_liberalism_right.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_type').GetValue, '(CFixedPoint)11')]" }
							}
							text_single = {
								fontsize = 13
								align = left|nobaseline
								max_width = 130
								elide = right
								text = "[Player.Custom('cc_pty_name_4')]"
							}
							expand = {}
							icon = { size = { 18 18 }  texture = "gfx/interface/icons/icon_warning.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_esc').GetValue, '(CFixedPoint)1')]"  tooltip = "CC_PTY_ESC_1_TT" }
							icon = { size = { 20 20 }  texture = "gfx/interface/icons/alerts_icons/imminent_revolt.dds"  visible = "[GreaterThanOrEqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_esc').GetValue, '(CFixedPoint)2')]"  tooltip = "CC_PTY_ESC_2_TT" }
							icon = { size = { 20 20 }  texture = "gfx/interface/icons/flat_icons/star.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_dominant').GetValue, '(CFixedPoint)4')]"  tooltip = "CC_PTY_DOMINANT_TT" }
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 3
							icon = { size = { 18 18 }  texture = "gfx/interface/icons/flat_icons/happy.dds"  visible = "[GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_sat').GetValue, '(CFixedPoint)30')]"  tooltip = "CC_PTY_MOOD_PLEASED_TT" }
							icon = { size = { 18 18 }  texture = "gfx/interface/icons/flat_icons/neutral.dds"  visible = "[And(Not(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_sat').GetValue, '(CFixedPoint)30')), GreaterThanOrEqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_sat').GetValue, '(CFixedPoint)-20'))]"  tooltip = "CC_PTY_MOOD_CONTENT_TT" }
							icon = { size = { 18 18 }  texture = "gfx/interface/icons/flat_icons/sad.dds"  visible = "[And(Not(GreaterThanOrEqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_sat').GetValue, '(CFixedPoint)-20')), GreaterThanOrEqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_sat').GetValue, '(CFixedPoint)-50'))]"  tooltip = "CC_PTY_MOOD_DISCONTENT_TT" }
							icon = { size = { 18 18 }  texture = "gfx/interface/icons/alerts_icons/unhappy_estates.dds"  visible = "[Not(GreaterThanOrEqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_sat').GetValue, '(CFixedPoint)-50'))]"  tooltip = "CC_PTY_MOOD_ANGRY_TT" }
							text_single = { fontsize = 12  raw_text = "[FixedPointToInt(Player.MakeScope.GetVariable('cc_pty_4_sat').GetValue)]"  tooltip = "CC_PTY_SAT_TT" }
							icon = { size = { 14 14 }  texture = "gfx/interface/icons/text_icons/arrow_bonus_tier_1.dds"  visible = "[GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_target').GetValue, Add_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_sat').GetValue, '(CFixedPoint)1'))]"  tooltip = "CC_PTY_TARGET_TT" }
							icon = { size = { 14 14 }  texture = "gfx/interface/icons/text_icons/arrow_malus_tier_1.dds"  visible = "[GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_sat').GetValue, Add_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_4_target').GetValue, '(CFixedPoint)1'))]"  tooltip = "CC_PTY_TARGET_TT" }
							text_single = { fontsize = 10  default_format = "#weak"  raw_text = "[FixedPointToInt(Player.MakeScope.GetVariable('cc_pty_4_target').GetValue)]"  tooltip = "CC_PTY_TARGET_TT" }
							expand = {}
							icon = { size = { 18 18 }  texture = "gfx/interface/icons/character_roles/regent.dds"  tooltip = "CC_PTY_SEATS_TT" }
							text_single = { fontsize = 12  raw_text = "[FixedPointToInt(Player.MakeScope.GetVariable('cc_pty_4_seats').GetValue)]"  tooltip = "CC_PTY_SEATS_TT" }
