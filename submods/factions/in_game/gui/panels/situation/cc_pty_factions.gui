								icon = { size = { 22 22 }  texture = "gfx/interface/icons/societal_values/belligerent_vs_conciliatory_left.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_2_type').GetValue, '(CFixedPoint)5')]" }
								icon = { size = { 22 22 }  texture = "gfx/interface/icons/estates/peasants_estate.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_2_type').GetValue, '(CFixedPoint)6')]" }
								icon = { size = { 22 22 }  texture = "gfx/interface/icons/societal_values/traditionalist_vs_innovative_right.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_2_type').GetValue, '(CFixedPoint)7')]" }
								icon = { size = { 22 22 }  texture = "gfx/interface/icons/societal_values/absolutism_vs_liberalism_left.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_2_type').GetValue, '(CFixedPoint)8')]" }
								icon = { size = { 22 22 }  texture = "gfx/interface/icons/societal_values/centralization_vs_decentralization_right.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_2_type').GetValue, '(CFixedPoint)9')]" }
								icon = { size = { 22 22 }  texture = "gfx/interface/icons/subject_types/colonial_nation.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_2_type').GetValue, '(CFixedPoint)10')]" }
								icon = { size = { 22 22 }  texture = "gfx/interface/icons/societal_values/absolutism_vs_liberalism_right.dds"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_2_type').GetValue, '(CFixedPoint)11')]" }
