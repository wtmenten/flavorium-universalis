						layoutpolicy_horizontal = expanding
						autoresize = yes
						multiline = yes
						max_width = 360
						fontsize = 11
						text = "[Player.Custom('cc_pty_fx_discontent_4')]"
					}
				}
				hbox = {
					layoutpolicy_horizontal = expanding
					visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_pty_dominant').GetValue, '(CFixedPoint)4')]"
					spacing = 6
					vbox = {
						spacing = 0
						text_single = { fontsize = 11  align = left|nobaseline  text = "CC_PTY_FX_PUSH"  tooltip = "CC_PTY_DOMINANT_TT" }
						text_single = { fontsize = 11  raw_text = "[FixedPointToInt(Player.MakeScope.GetVariable('cc_pty_push_pct').GetValue)]%"  tooltip = "CC_PTY_FX_STRENGTH_TT" }
					}
					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						multiline = yes
						max_width = 360
						fontsize = 11
						text = "[Player.Custom('cc_pty_fx_push_4')]"
					}
				}
				hbox = {
					layoutpolicy_horizontal = expanding
					visible = "[Player.MakeScope.GetVariable('cc_pty_4_favour_on').IsSet]"
					spacing = 6
					vbox = {
						spacing = 0
						text_single = { fontsize = 11  align = left|nobaseline  text = "CC_PTY_FX_FAVOUR"  tooltip = "CC_PTY_FX_FAVOUR_TT" }
						
					}
					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						multiline = yes
						max_width = 360
						fontsize = 11
						text = "[Player.Custom('cc_pty_fx_favour_4')]"
					}
				}
			}

		}
	}
}
