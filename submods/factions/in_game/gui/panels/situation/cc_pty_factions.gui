								text_single = { fontsize = 11  default_format = "#weak"  align = left|nobaseline  visible = "[Not(Player.MakeScope.GetVariable('cc_pty_4_leader').IsSet)]"  text = "CC_PTY_NO_LEADER"  tooltip = "CC_PTY_NO_LEADER_TT" }
