			# ---- Liberal Thought (age of absolutism onward) ----
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 6
				margin = { 4 2 }
				visible = "[Player.MakeScope.GetVariable('cc_pty_liberal_thought').IsSet]"
				text_single = { fontsize = 11  default_format = "#weak"  text = "CC_PTY_LABEL_LIBERAL_THOUGHT"  tooltip = "CC_PTY_LIBERAL_THOUGHT_TT" }
				widget = {
					size = { 300 10 }
					tooltip = "CC_PTY_LIBERAL_THOUGHT_TT"
					progressbar = {
						size = { 100% 100% }
						noprogresstexture = "gfx/interface/progressbars/progress_bar_grey_alt.dds"
						progresstexture = "gfx/interface/progressbars/progress_bar_green_alt.dds"
						texture_density = 2
						spriteType = Corneredstretched
						spriteborder = { 12 0 }
						min = 0
						max = 100
						value = "[FixedPointToFloat(Player.MakeScope.GetVariable('cc_pty_liberal_thought').GetValue)]"
					}
					widget = {
						parentanchor = left|top
						position = { 50% 0 }
						size = { 2 100% }
						background = { using = color_white_texture  alpha = 0.55 }
					}
				}
				text_single = { fontsize = 11  raw_text = "[FixedPointToInt(Player.MakeScope.GetVariable('cc_pty_liberal_thought').GetValue)]" }
				expand = {}
			}

