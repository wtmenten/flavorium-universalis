######################################################################
# GENERATED by tools/generate_factions.py from the installed game's
# in_game/gui/attribute_columns/character.gui. Do not edit; rerun the generator, which also
# re-syncs this copy after an EU5 update.
#
# Vanilla's `character_info` type, unchanged except for the party icon added after the
# role icon. Every character picker row derives from this type (character_adm/dip/mil,
# character_ruler, character_general, ...), so a candidate's party shows wherever
# characters are chosen, the cabinet appointment picker included.
######################################################################

types CcPtyCharacterColumns
{
	type character_info = clickable_header_card {
		size = { -1 72 }

		datacontext = "[InteractionTarget.GetCharacter]"

		blockoverride "header_bg" {
			background = {
				using = color_black_texture
				texture_density = 2
				margin = { 1 1 }
				margin_bottom = 2
				alpha = 0.4
			}
			background = {
				using = bg_card_header_01_default
				alpha = 0.9
				blockoverride "header_color" {
					using = header_color_role_overlay
				}
			}
		}

		blockoverride "header_content" {
			datacontext = "[InteractionTarget.GetCharacter]"

			block "ui_action_setup" {
				tooltipmeta = {
					texture = "gfx/interface/icons/character_roles/adult.dds"
				}
				using = select_interaction_target_action_provider
			}

			block "header_content_layout" {
				hbox = {
					using = layoutpolicy_expanding
					margin = { 10 0 }
					visible = "[InteractionTarget.GetCharacter.IsValid]"

					widget = {
						size = { 70 -1 }
					}

					character_role_icon = {
						blockoverride "icon_size" {
							size = { 25 25 }
						}

						datacontext = "[InteractionTarget.GetCharacter.GetRoleMask]"
					}

					# Factions: the character's party (cc_pty_aff), one fixed icon per party.
					widget = {
						size = { 25 25 }
						icon = { size = { 25 25 }  texture = "gfx/interface/icons/estates/crown_estate.dds"  tooltip = "cc_pty_type_royalist"  visible = "[EqualTo_CFixedPoint(InteractionTarget.GetCharacter.MakeScope.GetVariable('cc_pty_aff').GetValue, '(CFixedPoint)1')]" }
						icon = { size = { 25 25 }  texture = "gfx/interface/icons/estates/nobles_estate.dds"  tooltip = "cc_pty_type_aristocratic"  visible = "[EqualTo_CFixedPoint(InteractionTarget.GetCharacter.MakeScope.GetVariable('cc_pty_aff').GetValue, '(CFixedPoint)2')]" }
						icon = { size = { 25 25 }  texture = "gfx/interface/icons/estates/burghers_estate.dds"  tooltip = "cc_pty_type_mercantile"  visible = "[EqualTo_CFixedPoint(InteractionTarget.GetCharacter.MakeScope.GetVariable('cc_pty_aff').GetValue, '(CFixedPoint)3')]" }
						icon = { size = { 25 25 }  texture = "gfx/interface/icons/estates/clergy_estate.dds"  tooltip = "cc_pty_type_clerical"  visible = "[EqualTo_CFixedPoint(InteractionTarget.GetCharacter.MakeScope.GetVariable('cc_pty_aff').GetValue, '(CFixedPoint)4')]" }
						icon = { size = { 25 25 }  texture = "gfx/interface/icons/societal_values/belligerent_vs_conciliatory_left.dds"  tooltip = "cc_pty_type_military"  visible = "[EqualTo_CFixedPoint(InteractionTarget.GetCharacter.MakeScope.GetVariable('cc_pty_aff').GetValue, '(CFixedPoint)5')]" }
						icon = { size = { 25 25 }  texture = "gfx/interface/icons/estates/peasants_estate.dds"  tooltip = "cc_pty_type_agrarian"  visible = "[EqualTo_CFixedPoint(InteractionTarget.GetCharacter.MakeScope.GetVariable('cc_pty_aff').GetValue, '(CFixedPoint)6')]" }
						icon = { size = { 25 25 }  texture = "gfx/interface/icons/societal_values/traditionalist_vs_innovative_right.dds"  tooltip = "cc_pty_type_reformist"  visible = "[EqualTo_CFixedPoint(InteractionTarget.GetCharacter.MakeScope.GetVariable('cc_pty_aff').GetValue, '(CFixedPoint)7')]" }
						icon = { size = { 25 25 }  texture = "gfx/interface/icons/societal_values/absolutism_vs_liberalism_left.dds"  tooltip = "cc_pty_type_absolutist"  visible = "[EqualTo_CFixedPoint(InteractionTarget.GetCharacter.MakeScope.GetVariable('cc_pty_aff').GetValue, '(CFixedPoint)8')]" }
						icon = { size = { 25 25 }  texture = "gfx/interface/icons/societal_values/centralization_vs_decentralization_right.dds"  tooltip = "cc_pty_type_regionalist"  visible = "[EqualTo_CFixedPoint(InteractionTarget.GetCharacter.MakeScope.GetVariable('cc_pty_aff').GetValue, '(CFixedPoint)9')]" }
						icon = { size = { 25 25 }  texture = "gfx/interface/icons/subject_types/colonial_nation.dds"  tooltip = "cc_pty_type_colonial"  visible = "[EqualTo_CFixedPoint(InteractionTarget.GetCharacter.MakeScope.GetVariable('cc_pty_aff').GetValue, '(CFixedPoint)10')]" }
						icon = { size = { 25 25 }  texture = "gfx/interface/icons/societal_values/absolutism_vs_liberalism_right.dds"  tooltip = "cc_pty_type_liberal"  visible = "[EqualTo_CFixedPoint(InteractionTarget.GetCharacter.MakeScope.GetVariable('cc_pty_aff').GetValue, '(CFixedPoint)11')]" }
					}

					widget = {
						size = { 20 -1 }
					}

					text_single = {
						using = layoutpolicy_expanding
						using = Font_Size_Medium
						default_format = "#yellow_titles"
						autoresize = no
						align = nobaseline
						raw_text = "[InteractionTarget.GetCharacter.GetNameToFitWithNoTooltip('(int32)-1', '(bool)yes')], [InteractionTarget.GetCharacter.GetAgeInYears]"

						sort_by_left_fade_highlight = {
							name = "name"
						}

						sort_by_right_fade_highlight = {
							name = "age"
						}
					}

					block "header_acceptance_icon" {}
				}
				hbox = {
					using = layoutpolicy_expanding
					margin = { 10 0 }
					visible = "[Not(InteractionTarget.GetCharacter.IsValid)]"

					widget = {
						size = { 70 -1 }
					}

					widget = {
						size = { 25 25 }
					}

					widget = {
						size = { 20 -1 }
					}

					text_single = {
						using = layoutpolicy_expanding
						using = Font_Size_Medium
						default_format = "#yellow_titles"
						autoresize = no
						align = nobaseline
						block "no_character_text" {
							text = "[InteractionTarget.GetCharacter.GetNameToFitWithNoTooltip('(int32)30', '(bool)yes')], [InteractionTarget.GetCharacter.GetAgeInYears]"
						}

						sort_by_left_fade_highlight = {
							name = "name"
						}

						sort_by_right_fade_highlight = {
							name = "age"
						}
					}
				}
			}
		}

		blockoverride "bottom_content" {
			hbox = {
				datacontext = "[InteractionTarget.GetCharacter]"
				margin = { 10 0 }

				widget = {
					size = { 80 -1 }
				}

				divider_flavor_01 = {
					layoutpolicy_vertical = expanding
					size = { 15 -1 }
				}

				block "abilities_area" {
					character_abilities = {
						name = "ability"
						blockoverride "abilities_bg" {}
						using = bg_sort_by_highlight
					}
				}

				block "extra_info_line_2" {

					divider_flavor_01 = {
						layoutpolicy_vertical = expanding
						size = { 15 -1 }
					}

					widget = {
						using = layoutpolicy_expanding
						hbox = {
							hbox = {
								spacing = 5
								datamodel = "[InteractionTarget.GetCharacter.GetTraits]"
								item = {
									widget = {
										size = { 30 30 }
										icon = {
											size = { 100% 100% }
											using = trait_item

											blockoverride "trait_item_size" {
												size = { 30 30 }
											}
											blockoverride "trait_positive_negative_overlay" {
												visible = "[Trait.IsCabinetTrait]"
												allow_outside = yes
												icon = {
													position = { 14 15 }
													ignore_layout = yes
													size = { 22 22 }
													texture = "gfx/interface/buttons/flats/plus.dds"
													visible = "[Not(Trait.IsBad)]"
													modify_texture = {
														blend_mode = colordodge
														using = color_light_green_texture
													}
												}
												icon = {
													ignore_layout = yes
													size = { 16 22 }
													position = { 18 16 }
													texture = "gfx/interface/buttons/flats/minus.dds"
													visible = "[Trait.IsBad]"
													modify_texture = {
														blend_mode = colordodge
														using = color_red_texture
													}
												}
											}
										}
									}
								}
							}

							expand = {}
						}
					}
				}
			}
		}

		block "portraits" {
			select_portrait = {				
				blockoverride "portrait_datacontext"
				{
					datacontext = "[InteractionTarget.GetCharacter]"
				}
				parentanchor = vcenter
				position = {-2 0}
				blockoverride "character_portrait_visible" {
					visible = yes
				}
				blockoverride "character_portrait_ani_visible" {
					visible = no
				}
			}
		}
	}
}
