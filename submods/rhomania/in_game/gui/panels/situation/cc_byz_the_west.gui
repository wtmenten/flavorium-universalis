	blockoverride "situation_extra_tabs_content" {
		button_secondary_tab_alt = {
			using = layoutpolicy_expanding
			blockoverride "tab_text" { text = "CC_BYZ_WEST_TAB_CONSISTORY" }
			action_tooltip = {
				title = "OPEN_TAB"
				on_action = "[SituationView.Vars.Set( 'situation_tab', 'cc_byz_west_consistory' )]"
			}
			down = "[SituationView.Vars.HasValue( 'situation_tab', 'cc_byz_west_consistory' )]"
		}
	}

	blockoverride "situation_extra_tab_panels" {
		scrollarea = {
			visible = "[SituationView.Vars.HasValue( 'situation_tab', 'cc_byz_west_consistory' )]"
			using = layoutpolicy_expanding
			scrollbarpolicy_horizontal = always_off
			autoresizeviewport = yes
			viewportwidget = { widget = { scissor = yes } }
			scrollbar_vertical = { using = Scrollbar_Vertical }
			scrollwidget = {
				vbox = {
					layoutpolicy_horizontal = expanding
					using = bg_secondary_inner_alt
					margin = { 10 8 }
					spacing = 6
					vbox = {
						layoutpolicy_horizontal = expanding
						background = { using = color_whiteish_texture  alpha = 0.10 }
						margin = { 10 8 }
						spacing = 5
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							text_single = { fontsize = 14  align = left|nobaseline  text = "CC_BYZ_WEST_CARD_CONSISTORY" }
							expand = {}
							icon = {
								size = { 20 20 }
								texture = "gfx/interface/icons/flat_icons/tabicons/info_flat_icon.dds"
								texture_density = 2
								tooltipwidget = {
									ContextualTooltipType = {
										blockoverride "title_text" { text = "CC_BYZ_WEST_CARD_CONSISTORY" }
										blockoverride "tooltip_content" {
											text_multi = { autoresize = yes  multiline = yes  max_width = 340  text = "CC_BYZ_WEST_CARD_CONSISTORY_INFO" }
										}
									}
								}
							}
						}
						widget = { size = { 32 2 }  background = { using = color_white_texture  alpha = 0.35 } }
						text_multi = { layoutpolicy_horizontal = expanding  autoresize = yes  multiline = yes  max_width = 480  fontsize = 11  default_format = "#weak"  text = "CC_BYZ_WEST_CARD_CONSISTORY_DESC" }
						text_single = { fontsize = 13  default_format = "#color_green"  text = "CC_BYZ_WEST_CONS_SITTING"  visible = "[Player.MakeScope.GetVariable('cc_byz_west_convened').IsSet]" }
						text_single = { fontsize = 13  default_format = "#weak"  text = "CC_BYZ_WEST_CONS_DORMANT"  visible = "[Not(Player.MakeScope.GetVariable('cc_byz_west_convened').IsSet)]" }
						hbox = {
							layoutpolicy_horizontal = expanding
							text_single = { fontsize = 13  text = "CC_BYZ_WEST_VOTES_EMPEROR" }
							expand = {}
							text_single = { fontsize = 13  text = "CC_BYZ_WEST_VOTES_WEST" }
							text_single = { fontsize = 15  default_format = "#color_yellow"  raw_text = " [FixedPointToInt(Player.MakeScope.GetVariable('cc_byz_west_votes_west').GetValue)]" }
						}
						text_single = { fontsize = 12  default_format = "#color_green"  text = "CC_BYZ_WEST_VOTES_SAFE"  visible = "[GreaterThan_CFixedPoint('(CFixedPoint)3', Player.MakeScope.GetVariable('cc_byz_west_votes_west').GetValue)]" }
						text_single = { fontsize = 12  default_format = "#color_yellow"  text = "CC_BYZ_WEST_VOTES_TIE"  visible = "[EqualTo_CFixedPoint(Player.MakeScope.GetVariable('cc_byz_west_votes_west').GetValue, '(CFixedPoint)3')]" }
						text_single = { fontsize = 12  default_format = "#color_red"  text = "CC_BYZ_WEST_VOTES_LOST"  visible = "[GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('cc_byz_west_votes_west').GetValue, '(CFixedPoint)3')]" }
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 2
							datamodel = "[Player.GetDiplomacy.GetSubjects]"
							ignoreinvisible = yes
							item = {
								hbox = {
									layoutpolicy_horizontal = expanding
									minimumsize = { -1 26 }
									spacing = 6
									visible = "[Country.MakeScope.GetVariable('cc_byz_is_exarchate').IsSet]"
									country_flag_small = {}
									text_single = { fontsize = 13  max_width = 220  elide = right  text = "[Country.GetName]" }
									text_single = { fontsize = 10  default_format = "#color_yellow"  text = "CC_BYZ_WEST_TAG_SENIOR"  visible = "[Country.MakeScope.GetVariable('cc_byz_exarch_senior').IsSet]" }
									expand = {}
									text_single = { fontsize = 11  default_format = "#weak"  text = "CC_BYZ_WEST_COL_VOTES" }
									text_single = { fontsize = 13  raw_text = "2"  visible = "[Country.MakeScope.GetVariable('cc_byz_exarch_senior').IsSet]" }
									text_single = { fontsize = 13  raw_text = "1"  visible = "[Not(Country.MakeScope.GetVariable('cc_byz_exarch_senior').IsSet)]" }
								}
							}
						}
						text_multi = { layoutpolicy_horizontal = expanding  autoresize = yes  multiline = yes  max_width = 480  fontsize = 11  default_format = "#weak"  text = "CC_BYZ_WEST_CONS_QUESTIONS" }
						hbox = {
							spacing = 6
							card_header_button_01 = {
								size = { 156 22 }
								scripted_action_tooltip = {
									click_type = left
									click_mode = single
									action_name = "cc_byz_io_convene_consistory"
									actor = "[SituationView.GetPlayer]"
									parameter = {
										parameter_name = "recipient"
										parameter_value = "[SituationView.GetActiveSituation.GetSituation]"
									}
								}
								enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
								tooltipwidget = { using = action_tooltip_pop_out }
								text_single = { parentanchor = center  align = center  fontsize = 10  text = "CC_BYZ_WEST_BTN_CC_BYZ_IO_CONVENE_CONSISTORY" }
							}
							card_header_button_01 = {
								size = { 156 22 }
								scripted_action_tooltip = {
									click_type = left
									click_mode = single
									action_name = "cc_byz_io_elevate_senior_exarch"
									actor = "[SituationView.GetPlayer]"
									parameter = {
										parameter_name = "recipient"
										parameter_value = "[SituationView.GetActiveSituation.GetSituation]"
									}
								}
								enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
								tooltipwidget = { using = action_tooltip_pop_out }
								text_single = { parentanchor = center  align = center  fontsize = 10  text = "CC_BYZ_WEST_BTN_CC_BYZ_IO_ELEVATE_SENIOR_EXARCH" }
							}
							card_header_button_01 = {
								size = { 156 22 }
								scripted_action_tooltip = {
									click_type = left
									click_mode = single
									action_name = "cc_byz_io_dissolve_prefecture"
									actor = "[SituationView.GetPlayer]"
									parameter = {
										parameter_name = "recipient"
										parameter_value = "[SituationView.GetActiveSituation.GetSituation]"
									}
								}
								enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
								tooltipwidget = { using = action_tooltip_pop_out }
								text_single = { parentanchor = center  align = center  fontsize = 10  text = "CC_BYZ_WEST_BTN_CC_BYZ_IO_DISSOLVE_PREFECTURE" }
							}
						}
					}
				}
			}
		}
	}
}
